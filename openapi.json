                                            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                                            "refresh_token": "def50200a1b2c3d4e5f6..."
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "summary": "Refresh JWT token",
                "description": "Exchanges a valid refresh token for a new JWT access token and refresh token.",
                "requestBody": {
                    "description": "Refresh token used to obtain a new JWT access token",
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "refresh_token"
                                ],
                                "properties": {
                                    "refresh_token": {
                                        "type": "string",
                                        "description": "Valid refresh token"
                                    }
                                }
                            },
                            "examples": {
                                "auth-example": {
                                    "summary": "Example of refresh token request",
                                    "value": {
                                        "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "security": []
            }
        },
